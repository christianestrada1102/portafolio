# Live Sky — Vercel environment variables
# Copy to .env.local for local dev with `vercel dev`

# Secret shared between the Linux daemon and /api/heartbeat
HEARTBEAT_SECRET=replace_with_a_long_random_string

# Upstash Redis REST (Settings → REST API in the Upstash dashboard)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# GitHub personal access token (public_repo or read:user scope)
# Avoids the 60 req/h unauthenticated limit
GITHUB_TOKEN=github_pat_...
