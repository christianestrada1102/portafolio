# Live Sky — Vercel environment variables
# Copy this to .env.local for local Vercel dev (vercel dev)

# Secret shared between the Linux daemon and /api/heartbeat
HEARTBEAT_SECRET=replace_with_a_long_random_string

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase service role key — NEVER expose to the browser
# (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# GitHub personal access token (read:user, read:org scopes are enough)
# Avoids the 60 req/h unauthenticated limit
GITHUB_TOKEN=github_pat_...
